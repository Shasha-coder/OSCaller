# ==============================================================================
# OSCALLER — environment template
# Copy to .env.local. Never commit real secrets.
#   copy .env.example .env.local
# ==============================================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Google Maps (required for the map + reverse geocode) ---
# Browser map uses the NEXT_PUBLIC_ key. Restrict it to your domain in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_maps_browser_key
GOOGLE_MAPS_API_KEY=your_maps_server_key

# --- Twilio (SMS OTP + outbound voice fallback) ---
# Console → Account SID / Auth Token
# Phone Numbers → buy or reuse an E.164 voice+SMS number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Retell AI (Aria voice agent) ---
RETELL_API_KEY=key_xxxxxxxx
RETELL_WEBHOOK_SECRET=whsec_xxxxxxxx
RETELL_DEFAULT_AGENT_ID=agent_xxxxxxxx
# Must be a Retell-imported number in E.164, matching the country you serve
RETELL_DEFAULT_FROM_NUMBER=+15551234567

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# --- Gemini (photo / video issue analysis) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Upstash Redis (OTP + dispatch cache) ---
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# --- Optional: API key for machine-to-machine routes ---
OSCALLER_API_KEY=generate_a_long_random_string

# --- Optional: legacy ElevenLabs agent ---
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
